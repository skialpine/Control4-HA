          <Icon width="70" height="70">controller://driver/Control4.HA.Switch/icons/off-70.png</Icon>
        </state>
        <state id="buttons">
          <Icon width="300" height="300">controller://driver/Control4.HA.Switch/icons/buttons-300.png</Icon>
          <Icon width="90" height="90">controller://driver/Control4.HA.Switch/icons/buttons-90.png</Icon>
          <Icon width="70" height="70">controller://driver/Control4.HA.Switch/icons/buttons-70.png</Icon>
        </state>
        <state id="unavailable">
          <Icon width="300" height="300">controller://driver/Control4.HA.Switch/icons/unavailable-300.png</Icon>
          <Icon width="90" height="90">controller://driver/Control4.HA.Switch/icons/unavailable-90.png</Icon>
          <Icon width="70" height="70">controller://driver/Control4.HA.Switch/icons/unavailable-70.png</Icon>
        </state>
      </display_icons>
    </navigator_display_option>
  </capabilities>
  <proxies>
    <proxy proxybindingid="5001" primary="True" name="Home Assistant Switch">uibutton</proxy>
  </proxies>
