      <command>
        <name>Set Target Humidity</name>
        <description>Set target humidity on NAME to PARAM1 percent</description>
        <params><param><name>Percent</name><type>STRING</type></param></params>
      </command>
    </commands>
    <actions>
      <!-- #embed ../../src/ha/endpoint-actions.xml -->
