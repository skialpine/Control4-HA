<devicedata>
  <name>Home Assistant Blinds</name>
  <version />
  <manufacturer>SkiAlpine Labs</manufacturer>
  <model>Control4.HA.Blinds</model>
  <creator>skialpine</creator>
  <control>lua_gen</control>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 skialpine; template components copyright Finite Labs and their respective authors.</copyright>
  <created>11/24/2026 12:00:00 PM</created>
  <modified />
  <minimum_os_version>3.3.0</minimum_os_version>
  <composer_categories>
    <category>Other</category>
  </composer_categories>
  <config>
    <script file="driver.lua" jit="1" />
    <documentation file="www/documentation/index.html" />
    <properties>
      <!-- #embed ../../src/ha/endpoint-properties.xml -->
      <!-- #embed ../../src/ha/cover-position-property.xml -->
      <property>
        <name>Control method</name>
        <type>LIST</type>
        <default>Automatic</default>
        <items>
          <item>Automatic</item>
          <item>Lift</item>
          <item>Tilt</item>
        </items>
        <description>Choose whether the native control moves the blind or tilts its slats. Automatic uses lift when available.</description>
      </property>
    </properties>
    <tabs>
      <tab name="Device Setup" file="html/index.html" />
    </tabs>
    <commands>
      <command>
        <name>Open</name>
        <description>Open NAME</description>
      </command>
      <command>
        <name>Close</name>
        <description>Close NAME</description>
      </command>
      <command>
        <name>Stop</name>
        <description>Stop movement on NAME</description>
      </command>
      <command>
        <name>Set Position</name>
        <description>Move NAME to PARAM1 percent open</description>
        <params><param><name>Percent</name><type>STRING</type></param></params>
      </command>
      <command>
        <name>Open Tilt</name>
        <description>Open the slats on NAME</description>
      </command>
      <command>
        <name>Close Tilt</name>
        <description>Close the slats on NAME</description>
      </command>
      <command>
        <name>Stop Tilt</name>
        <description>Stop tilting the slats on NAME</description>
      </command>
      <command>
        <name>Set Tilt</name>
        <description>Set slat position on NAME to PARAM1 percent open</description>
        <params><param><name>Percent</name><type>STRING</type></param></params>
      </command>
    </commands>
    <actions>
      <!-- #embed ../../src/ha/endpoint-actions.xml -->
    </actions>
  </config>
  <capabilities>
    <can_stop>false</can_stop>
    <driver_handles_toggle>true</driver_handles_toggle>
    <has_level>false</has_level>
    <level_discrete_control>false</level_discrete_control>
    <level_closed>0</level_closed>
    <level_open>100</level_open>
    <level_unknown>-1</level_unknown>
  </capabilities>
  <proxies qty="1">
    <proxy proxybindingid="5001" primary="True" name="Home Assistant Blinds">blind</proxy>
  </proxies>
