<devicedata>
  <name>HA Generic Sensor</name>
  <version />
  <manufacturer>SkiAlpine Labs</manufacturer>
  <model>HA Generic Sensor</model>
  <creator>skialpine</creator>
  <control>lua_gen</control>
  <driver>DriverWorks</driver>
  <combo>true</combo>
  <copyright>Copyright 2026 skialpine. Template components copyright Finite Labs and their respective authors.</copyright>
  <created>11/24/2026 12:00:00 PM</created>
  <modified />
  <minimum_os_version>3.3.0</minimum_os_version>
  <composer_categories>
    <category>Experience Button</category>
  </composer_categories>
  <conditionals>
    <conditional>
      <id>1000</id>
      <name>HAS_NUMERIC_READING</name>
      <type>SIMPLE</type>
      <condition_statement>Reading is numeric</condition_statement>
      <description>Reading is numeric</description>
      <sort_order>0</sort_order>
    </conditional>
    <conditional>
      <id>1002</id>
      <name>IS_AVAILABLE</name>
      <type>SIMPLE</type>
      <condition_statement>Sensor is available</condition_statement>
      <description>Sensor is available</description>
      <sort_order>2</sort_order>
    </conditional>
  </conditionals>
  <events>
    <event>
      <id>1000</id>
      <name>Reading changed</name>
      <description>When NAME reports a changed value or unit</description>
    </event>
    <event>
      <id>1002</id>
      <name>Device became unavailable</name>
      <description>When NAME stops reporting its current state</description>
    </event>
  </events>
  <config>
    <script file="driver.lua" jit="1" />
    <documentation file="www/documentation/index.html" />
    <properties>
      <!-- #embed ../../src/ha/endpoint-properties.xml -->
      <property>
        <name>Entity ID</name>
        <type>STRING</type>
        <readonly>false</readonly>
        <default />
        <attributes>1</attributes>
      </property>
      <property>
        <name>Reading</name>
        <type>STRING</type>
        <default>Unavailable</default>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Sensor Type</name>
        <type>LIST</type>
        <default>Automatic</default>
        <attributes>1</attributes>
        <description>Automatic uses the description reported by Home Assistant.</description>
        <items>
          <item>Automatic</item>
          <item>Generic</item>
          <item>Temperature</item>
          <item>Humidity</item>
        </items>
      </property>
      <property>
        <name>Unit Fallback</name>
        <type>LIST</type>
        <default>None</default>
        <attributes>1</attributes>
        <description>Choose the scale only if Home Assistant reports a temperature without its unit.</description>
        <items>
          <item>None</item>
          <item>Celsius</item>
          <item>Fahrenheit</item>
        </items>
      </property>
      <property>
        <name>Value</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default />
        <attributes>1</attributes>
      </property>
      <property>
        <name>Last Updated</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default />
      </property>
      <property>
        <name>Poll Timer</name>
        <type>LIST</type>
        <default>Off</default>
        <attributes>1</attributes>
        <description>Turn off the periodic refresh retained from this project's previous sensor driver.</description>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
      </property>
    </properties>
    <tabs>
      <tab name="Device Setup" file="html/index.html" />
    </tabs>
    <commands />
    <actions>
      <action>
        <name>Refresh Sensor</name>
        <command>REFRESH</command>
      </action>
      <!-- #embed ../../src/ha/endpoint-actions.xml -->
    </actions>
  </config>
  <capabilities />
  <proxy name="HA Generic Sensor">other</proxy>
  <connections>
    <connection>
      <id>999</id>
      <facing>1</facing>
      <connectionname>Device Link</connectionname>
      <type>1</type>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>HA_DEVICE</classname>
          <autobind>True</autobind>
        </class>
        <class>
          <classname>SKIALPINE_HA_SUITE_V1</classname>
        </class>
      </classes>
    </connection>
    <connection>
      <id>500</id>
      <facing>6</facing>
      <connectionname>Temperature Value</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>TEMPERATURE_VALUE</classname>
        </class>
      </classes>
    </connection>
    <connection>
      <id>600</id>
      <facing>6</facing>
      <connectionname>Humidity</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>HUMIDITY_VALUE</classname>
        </class>
      </classes>
    </connection>
  </connections>
</devicedata>
